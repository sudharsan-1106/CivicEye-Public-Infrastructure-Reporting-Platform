# =====================================================================
# CivicEye Environment Configuration
# =====================================================================

# 1. Supabase Project Configuration
# Retrieve these from your Supabase Dashboard: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Service Role Key (Keep private, never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Map Configuration
# Supports OpenStreetMap (default), Mapbox, or Google Maps
NEXT_PUBLIC_MAP_PROVIDER=osm
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-token-here

# 3. Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
